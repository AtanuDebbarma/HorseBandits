<?xml version="1.0" encoding="utf-8"?>
<CraftingPieces>
	<!-- Clone of spear_blade_27 (Jereed head) with stack_amount 8.
	     Must also be listed as UsablePiece on the Javelin template (see crafting_templates XSLT)
	     or Bannerlord invalidates the piece and horse_bandits_javelin becomes null. is_hidden keeps it out of the forge UI. -->
	<CraftingPiece
		id="horse_bandits_javelin_blade"
		name="{=hb_javelin_blade}Bandit Javelin Head"
		tier="5"
		piece_type="Blade"
		mesh="spear_blade_27"
		length="69.5"
		weight="0.5"
		is_hidden="true"
		excluded_item_usage_features="swing">
		<BladeData
			stack_amount="8"
			physics_material="wood_weapon"
			body_name="bo_spear_b"
			holster_mesh="throwing_spear_quiver_2"
			holster_body_name="bo_throwing_spear_quiver_2"
			holster_mesh_length="94.6">
			<Thrust
				damage_type="Pierce"
				damage_factor="2.8"/>
		</BladeData>
		<Materials>
			<Material id="Iron5" count="2"/>
		</Materials>
	</CraftingPiece>

	<!-- Same as Bandit Javelin head but stack 4 for Imperial Bandit Horseman (T4). -->
	<CraftingPiece
		id="horse_bandits_javelin_blade_4"
