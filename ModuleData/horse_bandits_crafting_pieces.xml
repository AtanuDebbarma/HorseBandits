		mesh="spear_blade_27"
		length="69.5"
		weight="0.5"
		is_hidden="true"
		excluded_item_usage_features="swing">
		<BladeData
			stack_amount="4"
			physics_material="wood_weapon"
			body_name="bo_spear_b"
			holster_mesh="throwing_spear_quiver_2"
			holster_body_name="bo_throwing_spear_quiver_2"
			holster_mesh_length="94.6">
			<Thrust
				damage_type="Pierce"
				damage_factor="2.8"/>
		</BladeData>
		<Materials>
			<Material id="Iron5" count="2"/>
		</Materials>
	</CraftingPiece>

	<!-- Clone of spear_blade_15 (Simple Javelin look) with stack 8 for Brigand cav troops. -->
	<CraftingPiece
		id="horse_bandits_simple_javelin_blade"
		name="{=hb_simple_javelin_blade}Large Bag Simple Javelin Head"
		tier="2"
