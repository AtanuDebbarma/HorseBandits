<?xml version="1.0" encoding="utf-8"?>
<partyTemplates>
	<!--
		Kept only because Culture.horse_bandits references these template IDs.
		The mod does not spawn Horse Bandits clan parties; conversion injects troops
		into existing vanilla bandit parties instead.
	-->
	<MBPartyTemplate id="horse_bandits_template">
		<stacks>
			<PartyTemplateStack
				min_value="2"
				max_value="27"
				troop="NPCCharacter.mounted_pillager"/>
			<PartyTemplateStack
				min_value="0"
				max_value="12"
				troop="NPCCharacter.mounted_ransacker"/>
			<PartyTemplateStack
				min_value="0"
				max_value="6"
				troop="NPCCharacter.mounted_ransacker"/>
		</stacks>
	</MBPartyTemplate>
	<MBPartyTemplate id="horse_bandits_boss_party_template">
		<stacks>
			<PartyTemplateStack
				min_value="2"
				max_value="4"
				troop="NPCCharacter.mounted_ransacker"/>
			<PartyTemplateStack
				min_value="1"
				max_value="1"
				troop="NPCCharacter.horse_bandits_chief"/>
			<PartyTemplateStack
				min_value="1"
				max_value="1"
				troop="NPCCharacter.horse_bandits_boss"/>
		</stacks>
	</MBPartyTemplate>
</partyTemplates>
